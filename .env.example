# Docker Compose 变量模板（阶段 23）
#
# 用法：cp .env.example .env
# 说明：本文件仅供 docker compose 使用；本地开发（非容器）请用 backend/.env.example。
#       不创建本文件也能直接 docker compose up —— compose 文件里为每个变量都写了默认值。
#       本文件已被 .gitignore 排除（.env），不会被提交。

# ── 端口映射（宿主端口，避免与本机 MySQL 3306 / Redis 6379 冲突） ──
APP_PORT=8000
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380

# ── MySQL ★（首次 up 时生效，之后改这里不会修改已有数据卷里的密码） ──
DB_PASSWORD=maoliao_dev_pwd
DB_NAME=cat_pic

# ── JWT ★ 请改成随机长字符串 ──
JWT_SECRET_KEY=please-change-me-to-a-random-long-string

# ── AI（可选：留空则 AI 接口返回 503，其余功能正常） ──
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# AI_MODELS=deepseek-chat|DeepSeek-V3|text|deepseek|tools,Qwen/Qwen3-VL-32B-Instruct|通义千问VL|vision|siliconflow
