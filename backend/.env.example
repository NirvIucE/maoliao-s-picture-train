# 猫里奥全栈云图库 — 环境变量模板
#
# 用法：复制为 backend/.env 后按需填写（.env 已被 .gitignore 排除，不会入库）
#     cp backend/.env.example backend/.env
#
# 说明：
# - ★ 为必填项；AI 相关项留空时，AI 接口返回 503，其余功能不受影响
# - Docker 部署时 docker-compose.yml 会用容器名覆盖 DB_HOST / REDIS_HOST（mysql / redis），
#   因此这里保持 localhost 即可同时用于本地开发

# ── MySQL ★ ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cat_pic

# ── Redis（连不上时缓存自动降级，不影响功能） ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT ★（请改成随机长字符串） ──
JWT_SECRET_KEY=please-change-me-to-a-random-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── AI 模型（可选） ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 模型注册表，格式：id|名称|类型(text或vision)|厂商|tools(可选，标记支持工具调用)
AI_MODELS=deepseek-chat|DeepSeek-V3|text|deepseek|tools,Qwen/Qwen3-VL-32B-Instruct|通义千问VL|vision|siliconflow

# ── AI 行为参数（可选，注释内为默认值） ──
# AI_SEARCH_BATCH_SIZE=50
# AI_SEARCH_VISION_TOP_N=5
# CHAT_MAX_CONTEXT_TOKENS=4096
# LLM_DEFAULT_TEMPERATURE=0.7
# LLM_DEFAULT_MAX_TOKENS=1024
# AI_TASK_CONCURRENCY=3
# AI_EDIT_TIMEOUT=300
# AGENT_MAX_TOOL_STEPS=5
# AGENT_TOOL_RESULT_LIMIT=10
# UPLOAD_ROOT=            # 留空则用 backend/src/uploads

# ── 日志（可选） ──
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG
LOG_LEVEL_ERROR_FILE=WARNING
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_ERROR_MAX_BYTES=5242880
LOG_ERROR_BACKUP_COUNT=5
LOG_DIR=logs
LOG_FORMAT=[%(asctime)s] [%(process)d] [%(levelname)s] [%(name)s] [%(lineno)d] [%(message)s]
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
